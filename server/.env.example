# --- Mahfuz Titas NOC — WhatsApp bridge ---
# Copy this file to ".env" and fill in your values.

PORT=4000

# From Meta → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_TOKEN=EAAG...your_access_token...
WHATSAPP_API_VERSION=v21.0

# ---- Per-client WhatsApp GROUP ----
# Each client has ONE group (client team + NOC engineers); alerts go there,
# NOT to personal numbers. The NOC app sends client.whatsapp with every alert.
# Optionally override server-side (clientId -> number, comma-separated allowed):
CLIENT_ROUTES={"rahim":"8801710000001,8801811111111","karim":"8801710000002"}

# ---- Optional GLOBAL NOC group (kept in cc on every alert) ----
# Leave empty if you don't want a global copy. WhatsApp Cloud API can't post to a
# real group, so this is a broadcast list of numbers.
ENGINEER_NUMBERS=

# Fallback recipient if a client has no group set
WHATSAPP_TO=
