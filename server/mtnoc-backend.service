[Unit]
Description=Mahfuz Titas NOC backend + WhatsApp bot (mahfuztitasaiagent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mtnoc/server
ExecStart=/usr/bin/node start-all.js
EnvironmentFile=/opt/mtnoc/server/.env
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
